#!/usr/bin/env bash
_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export QUESTDB_IMAGE=${QUESTDB_IMAGE:="questdb/questdb"}
export QUESTDB_IMAGE_VERSION=${QUESTDB_IMAGE_VERSION:="latest"}
export QUESTDB_ROOT=${QUESTDB_ROOT:="$DOKKU_LIB_ROOT/services/questdb"}
export DOKKU_LIB_HOST_ROOT=${DOKKU_LIB_HOST_ROOT:=$DOKKU_LIB_ROOT}
export QUESTDB_HOST_ROOT=${QUESTDB_HOST_ROOT:="$DOKKU_LIB_HOST_ROOT/services/questdb"}

export PLUGIN_UNIMPLEMENTED_SUBCOMMANDS=()
export PLUGIN_COMMAND_PREFIX="questdb"
export PLUGIN_CONFIG_ROOT=${PLUGIN_CONFIG_ROOT:="$DOKKU_LIB_ROOT/config/$PLUGIN_COMMAND_PREFIX"}
export PLUGIN_DATA_ROOT=$QUESTDB_ROOT
export PLUGIN_DATA_HOST_ROOT=$QUESTDB_HOST_ROOT
export PLUGIN_DATASTORE_PORTS=(8812)
export PLUGIN_DATASTORE_WAIT_PORT=8812
export PLUGIN_DEFAULT_ALIAS="DATABASE"
export PLUGIN_DISABLE_PULL=${QUESTDB_DISABLE_PULL:=}
export PLUGIN_DISABLE_PULL_VARIABLE="QUESTDB_DISABLE_PULL"
export PLUGIN_ALT_ALIAS="DOKKU_QUESTDB"
export PLUGIN_IMAGE=$QUESTDB_IMAGE
export PLUGIN_IMAGE_VERSION=$QUESTDB_IMAGE_VERSION
export PLUGIN_SCHEME="postgresql"
export PLUGIN_SERVICE="QuestDB"
export PLUGIN_VARIABLE="QUESTDB"
export PLUGIN_BASE_PATH="$PLUGIN_PATH"
export PLUGIN_CONFIG_SUFFIX="data"
if [[ -n $DOKKU_API_VERSION ]]; then
  export PLUGIN_BASE_PATH="$PLUGIN_ENABLED_PATH"
fi

export PLUGIN_BUSYBOX_IMAGE=${PLUGIN_BUSYBOX_IMAGE:=busybox:1.37.0-uclibc}
export PLUGIN_AMBASSADOR_IMAGE=${PLUGIN_AMBASSADOR_IMAGE:=dokku/ambassador:0.8.2}
export PLUGIN_S3BACKUP_IMAGE=${PLUGIN_S3BACKUP_IMAGE:=dokku/s3backup:0.18.0}
export PLUGIN_WAIT_IMAGE=${PLUGIN_WAIT_IMAGE:=dokku/wait:0.9.3}

export QUESTDB_CONFIG_OPTIONS=${QUESTDB_CONFIG_OPTIONS:=""}
